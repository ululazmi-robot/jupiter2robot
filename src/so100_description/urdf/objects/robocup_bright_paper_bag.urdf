<?xml version="1.0"?>
<robot name="robocup_bright_paper_bag">

  <!-- Main Bag Link (Parkson Paper Bag Original: 28cm H x 25cm W x 11cm D) -->
  <link name="paper_bag_link">
    
    <!-- Inertial properties for physics simulators (Gazebo) -->
    <inertial>
      <origin xyz="0.0 0.0 0.14" rpy="0 0 0"/>
      <!-- Lightweight kraft paper bag approximation (0.12 kg) -->
      <mass value="0.12"/>
      <inertia ixx="0.0014" ixy="0.0" ixz="0.0" iyy="0.0009" iyz="0.0" izz="0.0007"/>
    </inertial>

    <!-- Visual Representation: Authentic Parkson Kraft Paper Bag with Smooth Semicircular Handle -->
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://so100_description/meshes/parkson_bag_full.stl"/>
      </geometry>
      <material name="parkson_kraft_brown">
        <color rgba="0.76 0.58 0.38 1.0"/>
      </material>
    </visual>

    <!-- Collision Geometry for Grasping / Manipulation -->
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://so100_description/meshes/parkson_bag_full.stl"/>
      </geometry>
    </collision>
    
  </link>

  <!-- Gazebo-specific extensions for physical behavior -->
  <gazebo reference="paper_bag_link">
    <material>Gazebo/Wood</material>
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <maxVel>0.1</maxVel>
    <minDepth>0.001</minDepth>
    <provideFeedback>true</provideFeedback>
  </gazebo>

</robot>
