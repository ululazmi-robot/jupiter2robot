<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!--
  Chassis: footprint, drive wheels, casters, IMU frame, and the tower root.

  base_footprint is the ground-projected root; everything else hangs off base_link.
  This module owns the ONLY continuous joints on the base (the two wheels).
  -->


  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.015" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="-0.089 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://jupiterobot2_description/meshes/stacks/jupiter2_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="Black"/>
    </visual>
    <collision>
      <origin xyz="-0.089 0 0.039" rpy="0 0 0"/>
      <geometry>
        <box size="0.33 0.33 0.078"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.089 0 0.039" rpy="0 0 0"/>
      <mass value="4.6"/>
      <inertia ixx="0.0440772" ixy="0" ixz="0"
               iyy="0.0440772" iyz="0"
               izz="0.08349" />
    </inertial>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0.0 0.144 0.018" rpy="${-M_PI/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="${M_PI/2} 0 0"/>
      <geometry>
        <mesh filename="package://jupiterobot2_description/meshes/wheels/left_tire.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="FlatBlack"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.03" />
      <inertia ixx="9e-06" ixy="0.0" ixz="0.0"
               iyy="9e-06" iyz="0.0"
               izz="1.64e-05" />
      </inertial>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0.0 -0.144 0.018" rpy="${-M_PI/2} 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="${M_PI/2} 0 0"/>
      <geometry>
        <mesh filename="package://jupiterobot2_description/meshes/wheels/right_tire.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="FlatBlack"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.03" />
      <inertia ixx="9e-06" ixy="0.0" ixz="0.0"
               iyy="9e-06" iyz="0.0"
               izz="1.64e-05" />
      </inertial>
  </link>

  <joint name="caster_back_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back_right_link"/>
    <origin xyz="-0.177 -0.064 -0.0025" rpy="${-M_PI/2} 0 0"/>
  </joint>

  <link name="caster_back_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://jupiterobot2_description/meshes/wheels/caster.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="Grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.0125"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.065" />  <!--2/5*m*r^2-->
      <inertia ixx="4.0625e-06" ixy="0.0" ixz="0.0"
               iyy="4.0625e-06" iyz="0.0"
               izz="4.0625e-06" />
    </inertial>
  </link>

  <joint name="caster_back_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back_left_link"/>
    <origin xyz="-0.177 0.064 -0.0025" rpy="${-M_PI/2} 0 0"/>
  </joint>

  <link name="caster_back_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://jupiterobot2_description/meshes/wheels/caster.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="Grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.0125"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.065" />  <!--2/5*m*r^2-->
      <inertia ixx="4.0625e-06" ixy="0.0" ixz="0.0"
               iyy="4.0625e-06" iyz="0.0"
               izz="4.0625e-06" />
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.091 -0.1055 0.0535" rpy="${M_PI} 0 0"/>
  </joint>

  <link name="imu_link"/>

  <!-- base link for stacks -->
  <joint name="stack_joint" type="fixed">
    <parent link="base_link"/>
    <child link="stack_link"/>
    <origin xyz="-0.089 0 0" rpy="0 0 0"/>
  </joint>

  <link name="stack_link"/>

</robot>
