        </geometry>
        <material name="Grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.2" radius="0.005"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" />
        <mass value="0.0361" />
        <inertia ixx="0.000120559" ixy="0.0" ixz="0.0"
                 iyy="0.000120559" iyz="0.0"
                 izz="4.5125e-07" />
      </inertial>
    </link>
