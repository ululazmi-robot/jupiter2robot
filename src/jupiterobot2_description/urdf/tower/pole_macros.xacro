        </geometry>
        <material name="Grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.06" radius="0.005"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" />
        <mass value="0.0108" />
        <inertia ixx="3.3075e-06" ixy="0.0" ixz="0.0"
                 iyy="3.3075e-06" iyz="0.0"
                 izz="1.35e-07" />
      </inertial>
    </link>
  </xacro:macro>

