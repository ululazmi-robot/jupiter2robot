<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!--
  Parametric pole macros.

  Each macro emits one fixed joint plus one link, sized from the STL it points
  at. The `num` parameter is not cosmetic: link names are pole_N_<num>_link, so
  two calls with the same num silently collide. Existing call sites use num 0-3
  per level and 4-5 for the two head support posts.

  Two traps, both hit during the refactor:

  1. Never write substitution syntax inside a comment. xacro expands it even in
     comment text, and an undefined variable fails the whole expansion with
     "name 'X' is not defined".
  2. Never put a double hyphen inside a comment body. XML forbids it and the
     error points at the comment, not the cause. That includes nested comments:
     they cannot be nested at all.

  The meshes are package-qualified to jupiterobot2_description and must stay
  that way; this file is installed under the same package.
  -->

  <xacro:macro name="pole_40" params="parent num x y z">
    <joint name="pole_40_${num}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="pole_40_${num}_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>
    <link name="pole_40_${num}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://jupiterobot2_description/meshes/stacks/pole_40.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="Grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.04" radius="0.005"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" />
        <mass value="0.007" />
        <inertia ixx="9.91041667e-07" ixy="0.0" ixz="0.0"
                 iyy="9.91041667e-07" iyz="0.0"
                 izz="8.875e-08" />
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="pole_60" params="parent num x y z">
    <joint name="pole_60_${num}_joint" type="fixed">
      <parent link="${parent}"/>
