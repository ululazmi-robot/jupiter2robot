      <inertial>
        <origin xyz="0 0 0" />
        <mass value="0.0601" />
        <inertia ixx="0.000451125625" ixy="0.0" ixz="0.0"
                 iyy="0.000451125625" iyz="0.0"
                 izz="7.5125e-07" />
      </inertial>
    </link>
  </xacro:macro>

</robot>
